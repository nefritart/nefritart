---
import { getCollection } from 'astro:content';

// Dočasná ověřovací stránka — potvrzuje, že data z CMS tečou do webu.
// Ve Fázi 8 ji nahradí finální vizuál (Macaly → Astro šablony).
const products = (await getCollection('products'))
  .filter((p) => p.data.published)
  .sort((a, b) => a.data.order - b.data.order);

const categoryLabels: Record<string, string> = {
  pendants: 'Přívěsky',
  figurines: 'Figurky',
  earrings_rings: 'Náušnice a prsteny',
};
---

<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nefritart — Radek Beneš</title>
    <meta
      name="description"
      content="Ručně broušené amulety a talismany z pravého nefritu a jadeitu, inspirované duší Nového Zélandu."
    />
  </head>
  <body>
    <header>
      <h1>Nefritart</h1>
      <p>Ruční řezba nefritu inspirovaná duší Nového Zélandu.</p>
    </header>

    <main>
      <h2>Galerie ({products.length})</h2>

      {products.length === 0 && <p>Zatím tu nejsou žádné výrobky.</p>}

      <ul class="grid">
        {
          products.map((p) => (
            <li class="card">
              {p.data.images[0] && <img src={p.data.images[0]} alt={p.data.title_cs} loading="lazy" />}
              <h3>{p.data.title_cs}</h3>
              <p class="meta">
                {categoryLabels[p.data.category]}
                {p.data.dimensions && <> · {p.data.dimensions}</>}
              </p>
              {p.data.price_from_czk && <p class="price">od {p.data.price_from_czk.toLocaleString('cs-CZ')} Kč</p>}
            </li>
          ))
        }
      </ul>
    </main>

    <footer>
      <p>© Nefritart — Radek Beneš · Pardubice · IČO 29721849</p>
      <p><a href="/admin/">Administrace</a></p>
    </footer>

    <style>
      :root {
        --bg: #14181a;
        --fg: #e8e6e1;
        --muted: #9aa5a0;
        --jade: #4a8c6f;
      }
      body {
        margin: 0;
        padding: 2rem 1.5rem 4rem;
        background: var(--bg);
        color: var(--fg);
        font-family: system-ui, sans-serif;
        line-height: 1.6;
        max-width: 1100px;
        margin-inline: auto;
      }
      h1 {
        font-size: clamp(2.5rem, 8vw, 4rem);
        font-weight: 400;
        letter-spacing: 0.02em;
        margin: 0 0 0.25rem;
      }
      header p {
        color: var(--muted);
        margin: 0 0 3rem;
      }
      h2 {
        font-weight: 400;
        border-bottom: 1px solid #2a3033;
        padding-bottom: 0.5rem;
      }
      .grid {
        list-style: none;
        padding: 0;
        display: grid;
        gap: 2rem;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      }
      .card img {
        width: 100%;
        aspect-ratio: 1;
        object-fit: cover;
        border-radius: 2px;
        display: block;
      }
      .card h3 {
        font-weight: 500;
        margin: 0.75rem 0 0.25rem;
      }
      .meta {
        color: var(--muted);
        font-size: 0.9rem;
        margin: 0;
      }
      .price {
        color: var(--jade);
        margin: 0.25rem 0 0;
      }
      footer {
        margin-top: 4rem;
        padding-top: 1.5rem;
        border-top: 1px solid #2a3033;
        color: var(--muted);
        font-size: 0.9rem;
      }
      a {
        color: var(--jade);
      }
    </style>
  </body>
</html>
