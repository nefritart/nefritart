---
import '@fontsource-variable/cormorant-garamond';
import { getCollection } from 'astro:content';
import { ui, languages, contact, path, formatPrice, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const products = (await getCollection('products'))
  .filter((p) => p.data.published)
  .sort((a, b) => a.data.order - b.data.order);

/** Název položky v aktuálním jazyce, s návratem k češtině. */
function title(data: Record<string, any>): string {
  return data[`title_${lang}`] || data.title_cs;
}

// Hero na šířku: prosvícená zelená čepel na tmavém pozadí.
const HERO = '/images/products/img-6664.jpg';
// Hero na výšku (mobil): fotka na šířku by se ořízla na nečitelný pruh,
// proto svislý snímek, kde je přívěsek na šňůrce vidět celý.
const HERO_PORTRAIT = '/images/products/img-5953.jpg';
// O nefritu: surový kámen prosvícený baterkou, ukazuje translucenci.
const STONE = '/images/products/fcbd3c18-1085-4b5f-8d54-ca50f58259aa.jpg';
// Příběh: portrét autora (zrcadlíme, aby se díval do textu; převádíme do černobílé).
const PORTRAIT = '/images/products/img-6969.jpg';

const categories = ['pendants', 'figurines', 'earrings_rings'] as const;
const usedCategories = categories.filter((c) => products.some((p) => p.data.category === c));
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:image" content={new URL(HERO, Astro.site)} />
    <meta property="og:type" content="website" />
    {
      (Object.keys(languages) as Lang[]).map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(path(l), Astro.site)} />
      ))
    }
  </head>

  <body>
    <a class="skip" href="#main">→</a>

    <header id="siteHeader">
      <div class="bar">
        <a class="brand" href={path(lang)}>Nefrit Art</a>

        <nav class="menu" aria-label="Menu">
          <a href="#story">{t.nav.story}</a>
          <a href="#symbols">{t.nav.symbols}</a>
          <a href="#gallery">{t.nav.gallery}</a>
          <a href="#about">{t.nav.about}</a>
          <a href="#genuine">{t.nav.genuine}</a>
          <a href="#commission">{t.nav.commission}</a>
          <a href="#contact">{t.nav.contact}</a>
        </nav>

        <div class="langs">
          {
            (Object.keys(languages) as Lang[]).map((l) => (
              <a href={path(l)} class:list={['lang', { on: l === lang }]} hreflang={l}>
                {l.toUpperCase()}
              </a>
            ))
          }
        </div>
      </div>
    </header>

    <main id="main">
      <!-- HERO -->
      <section class="hero">
        <picture>
          <source media="(max-aspect-ratio: 3/4)" srcset={HERO_PORTRAIT} />
          <img src={HERO} alt="" class="hero-img" fetchpriority="high" />
        </picture>
        <div class="hero-veil"></div>
        <div class="hero-body">
          <p class="tagline">{t.hero.tagline}</p>
          <h1>{t.hero.title}</h1>
          <p class="lede">{t.hero.lede}</p>
          <div class="actions">
            <a class="btn primary" href="#gallery">{t.hero.ctaGallery}</a>
            <a class="btn ghost" href="#story">{t.hero.ctaStory}</a>
          </div>

          <ul class="badges">
            {t.hero.badges.map((b) => <li>{b}</li>)}
          </ul>
        </div>
      </section>

      <!-- PŘÍBĚH -->
      <section id="story" class="band split">
        <div class="split-text">
          <p class="eyebrow">{t.story.eyebrow}</p>
          <h2>{t.story.title}</h2>
          {t.story.body.map((p) => <p class="prose" set:html={p} />)}
          <blockquote class="pull">{t.story.quote}</blockquote>
          <p class="signature">{t.story.signature}</p>
        </div>
        <figure class="split-media sticky portrait">
          <img src={PORTRAIT} alt={t.story.portraitAlt} loading="lazy" />
          <figcaption>{t.story.signature}</figcaption>
        </figure>
      </section>

      <!-- SYMBOLY -->
      <section id="symbols" class="band">
        <div class="head">
          <p class="eyebrow">{t.symbols.eyebrow}</p>
          <h2>{t.symbols.title}</h2>
          <p class="prose wide" set:html={t.symbols.body} />
        </div>
        <ul class="symbols">
          {
            t.symbols.items.map((s) => (
              <li>
                <h3>{s.name}</h3>
                <p class="sub">{s.sub}</p>
                <p>{s.meaning}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- TRADICE -->
      <section id="tradition" class="band">
        <div class="head">
          <p class="eyebrow">{t.tradition.eyebrow}</p>
          <h2>{t.tradition.title}</h2>
        </div>
        <div class="tradition">
          {
            t.tradition.items.map((it) => (
              <article>
                <h3>{it.label}</h3>
                <p set:html={it.text} />
              </article>
            ))
          }
        </div>
      </section>

      <!-- GALERIE -->
      <section id="gallery" class="band">
        <div class="head">
          <p class="eyebrow">{t.gallery.eyebrow}</p>
          <h2>{t.gallery.title}</h2>
          <p class="prose wide">{t.gallery.lede}</p>
        </div>

        {
          products.length > 0 && usedCategories.length > 1 && (
            <div class="filters" role="group">
              <button type="button" class="chip on" data-filter="all">
                {t.gallery.all}
              </button>
              {usedCategories.map((c) => (
                <button type="button" class="chip" data-filter={c}>
                  {t.gallery.categories[c]}
                </button>
              ))}
            </div>
          )
        }

        {products.length === 0 && <p class="prose empty">{t.gallery.empty}</p>}

        <ul class="grid" id="grid">
          {
            products.map((p) => (
              <li class="card" data-cat={p.data.category}>
                <button
                  type="button"
                  class="shot"
                  data-full={p.data.images[0]}
                  data-caption={title(p.data)}
                >
                  {p.data.images[0] && <img src={p.data.images[0]} alt={title(p.data)} loading="lazy" />}
                </button>
                <div class="card-body">
                  <h3>{title(p.data)}</h3>
                  <p class="meta">
                    {t.gallery.categories[p.data.category]}
                    {p.data.stone && <> · {t.gallery.stones[p.data.stone]}</>}
                    {p.data.dimensions && <> · {p.data.dimensions}</>}
                    {p.data.weight_g && <> · {p.data.weight_g} {t.gallery.weightUnit}</>}
                    {p.data.year && <> · {p.data.year}</>}
                  </p>
                  {p.data.availability && (
                    <p class:list={['stav', p.data.availability]}>
                      {t.gallery.availability[p.data.availability]}
                    </p>
                  )}
                  {p.data.price_from_czk && (
                    <p class="price">
                      {t.gallery.priceFrom} {formatPrice(p.data.price_from_czk, lang)}
                    </p>
                  )}
                </div>
              </li>
            ))
          }
        </ul>

        {t.gallery.priceNote && <p class="price-disclaimer">{t.gallery.priceNote}</p>}
      </section>

      <!-- O NEFRITU -->
      <section id="about" class="band split reverse">
        <div class="split-text">
          <p class="eyebrow">{t.about.eyebrow}</p>
          <h2>{t.about.title}</h2>
          {t.about.body.map((p) => <p class="prose" set:html={p} />)}
          <h3 class="minor">{t.about.depositsTitle}</h3>
          <p class="prose" set:html={t.about.deposits} />
        </div>
        <figure class="split-media sticky">
          <img src={STONE} alt={t.about.imageAlt} loading="lazy" />
        </figure>
      </section>

      <!-- JAK POZNAT -->
      <section id="genuine" class="band">
        <div class="head">
          <p class="eyebrow">{t.genuine.eyebrow}</p>
          <h2>{t.genuine.title}</h2>
          <p class="prose wide">{t.genuine.lede}</p>
        </div>
        <ol class="signs">
          {
            t.genuine.items.map((it, i) => (
              <li>
                <span class="num">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3>{it.label}</h3>
                  <p>{it.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <div class="care">
          <h3>{t.genuine.careTitle}</h3>
          <p>{t.genuine.care}</p>
        </div>
      </section>

      <!-- ZAKÁZKOVÁ TVORBA -->
      <section id="commission" class="band">
        <div class="head">
          <p class="eyebrow">{t.commission.eyebrow}</p>
          <h2>{t.commission.title}</h2>
          <p class="prose wide">{t.commission.lede}</p>
        </div>

        <form
          class="poptavka"
          id="commissionForm"
          novalidate
          data-key={contact.formAccessKey}
          data-mailto={contact.email}
          data-subject={`Poptávka z webu — ${t.commission.eyebrow}`}
          data-ok={t.commission.ok}
          data-err={t.commission.err}
          data-sending={t.commission.sending}
          data-submit={t.commission.submit}
        >
          <div class="row">
            <label>
              <span class="lbl">{t.commission.fEmail} *</span>
              <input type="email" name="email" required autocomplete="email" />
            </label>
            <label>
              <span class="lbl">{t.commission.fPhone} <em>{t.commission.fPhoneHint}</em></span>
              <input type="tel" name="telefon" autocomplete="tel" />
            </label>
          </div>

          <div class="row">
            <label>
              <span class="lbl">{t.commission.fKind}</span>
              <select name="druh">
                {t.commission.fKinds.map((k) => <option>{k}</option>)}
              </select>
            </label>
            <label>
              <span class="lbl">{t.commission.fColor}</span>
              <select name="barva">
                {t.commission.fColors.map((c) => <option>{c}</option>)}
              </select>
            </label>
          </div>

          <div class="row">
            <label>
              <span class="lbl">{t.commission.fMotif} <em>{t.commission.fMotifHint}</em></span>
              <input type="text" name="motiv" />
            </label>
            <label>
              <span class="lbl">{t.commission.fSize} <em>{t.commission.fSizeHint}</em></span>
              <input type="text" name="velikost" />
            </label>
          </div>

          <label class="full">
            <span class="lbl">{t.commission.fNote}</span>
            <textarea name="poznamka" rows="4"></textarea>
          </label>

          <div class="send">
            <button type="submit" class="btn primary">{t.commission.submit}</button>
            <p class="form-msg" id="formMsg" role="status" aria-live="polite"></p>
          </div>

          <p class="gdpr">{t.commission.gdpr}</p>
        </form>
      </section>

      <!-- KONTAKT -->
      <section id="contact" class="band">
        <div class="head">
          <p class="eyebrow">{t.contact.eyebrow}</p>
          <h2>{t.contact.title}</h2>
          <p class="prose wide">{t.contact.lede}</p>
          <p class="price-note">{t.contact.priceNote}</p>
        </div>

        <div class="contacts">
          <a class="tile" href={`mailto:${contact.email}`}>
            <span class="tile-label">{t.contact.email}</span>
            <span class="tile-value">{contact.email}</span>
          </a>
          <a class="tile" href={`tel:${contact.phoneHref}`}>
            <span class="tile-label">{t.contact.phone}</span>
            <span class="tile-value">{contact.phone}</span>
          </a>
          <a class="tile" href={contact.facebook} target="_blank" rel="noopener">
            <span class="tile-label">{t.contact.where}</span>
            <span class="tile-value">{t.contact.facebook} →</span>
          </a>
        </div>
        <p class="thanks">{t.contact.thanks}</p>
      </section>
    </main>

    <footer>
      <nav class="foot-nav" aria-label="Menu">
        <a href="#story">{t.nav.story}</a>
        <a href="#symbols">{t.nav.symbols}</a>
        <a href="#gallery">{t.nav.gallery}</a>
        <a href="#about">{t.nav.about}</a>
        <a href="#genuine">{t.nav.genuine}</a>
        <a href="#contact">{t.nav.contact}</a>
      </nav>
      <p>{t.footer.rights}</p>
      <p class="place">{t.footer.place}</p>
    </footer>

    <!-- LIGHTBOX -->
    <div class="lightbox" id="lightbox" hidden>
      <button type="button" class="lb-close" id="lbClose" aria-label="×">×</button>
      <figure>
        <img id="lbImg" alt="" />
        <figcaption id="lbCap"></figcaption>
      </figure>
    </div>

    <style>
      :root {
        --ink: #0b0e0d;
        --ink-2: #12100e;
        --surface: #141817;
        --paper: #e9e6de;
        --paper-dim: #a8b0aa;
        --paper-faint: #79817b;
        --jade: #5fae82;
        --jade-deep: #2f6b52;
        --amber: #c99a5b;
        --line: #232927;

        --display: 'Cormorant Garamond Variable', Georgia, serif;
        --sans: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;

        --pad: clamp(1.25rem, 5vw, 5rem);
        --gap: clamp(3rem, 9vw, 8rem);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
        /* plynulá škála: ~17 px na mobilu, ~19 px na notebooku, 21 px na velkém monitoru */
        font-size: clamp(17px, 0.25vw + 16.1px, 21px);
      }

      body {
        margin: 0;
        background: var(--ink);
        color: var(--paper);
        font-family: var(--sans);
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }

      img {
        max-width: 100%;
        display: block;
      }

      .skip {
        position: absolute;
        left: -9999px;
      }

      /* ---------- hlavička ---------- */

      header {
        position: fixed;
        inset: 0 0 auto;
        z-index: 50;
        transition: background 0.4s ease, border-color 0.4s ease;
        border-bottom: 1px solid transparent;
      }

      header.stuck {
        background: rgba(11, 14, 13, 0.9);
        backdrop-filter: blur(12px);
        border-bottom-color: var(--line);
      }

      .bar {
        display: flex;
        align-items: center;
        gap: 2rem;
        padding: 1rem var(--pad);
      }

      .brand {
        font-family: var(--display);
        font-size: 1.6rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        color: var(--paper);
        text-decoration: none;
        flex: none;
      }

      .menu {
        display: none;
        gap: 1.75rem;
        margin-inline: auto;
      }

      @media (min-width: 1040px) {
        .menu {
          display: flex;
        }
      }

      .menu a {
        color: var(--paper-dim);
        text-decoration: none;
        font-size: 0.9rem;
        letter-spacing: 0.05em;
        transition: color 0.25s;
      }

      .menu a:hover {
        color: var(--jade);
      }

      .langs {
        display: flex;
        gap: 0.15rem;
        margin-left: auto;
        flex: none;
      }

      @media (min-width: 1040px) {
        .langs {
          margin-left: 0;
        }
      }

      .lang {
        font-size: 0.7rem;
        letter-spacing: 0.1em;
        color: var(--paper-faint);
        text-decoration: none;
        padding: 0.3rem 0.45rem;
        border-radius: 2px;
        transition: color 0.25s;
      }

      .lang:hover {
        color: var(--paper);
      }

      .lang.on {
        color: var(--ink);
        background: var(--jade);
      }

      /* ---------- hero ---------- */

      .hero {
        position: relative;
        min-height: 100svh;
        display: grid;
        align-items: end;
        overflow: hidden;
      }

      .hero-img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 48%;
        /* kámen má na webu svítit — vracíme mu sytost a kresbu */
        filter: saturate(1.18) contrast(1.12);
      }

      /* Na stojatých displejích se načte svislý snímek — posuneme těžiště
         výš, aby přívěsek nezakryl spodní text. */
      @media (max-aspect-ratio: 3 / 4) {
        .hero-img {
          object-position: center 38%;
        }
      }

      .hero-veil {
        position: absolute;
        inset: 0;
        /* Jen tolik, aby text držel čitelnost — kámen necháme svítit. */
        background:
          /* horní pruh pod hlavičku, zrcadlí spodní přechod */
          linear-gradient(to bottom, rgba(11, 14, 13, 0.82) 0%, rgba(11, 14, 13, 0.5) 7%, rgba(11, 14, 13, 0.15) 15%, transparent 24%),
          linear-gradient(to top, var(--ink) 0%, rgba(11, 14, 13, 0.6) 22%, rgba(11, 14, 13, 0.12) 55%, transparent 80%),
          linear-gradient(to right, rgba(11, 14, 13, 0.55) 0%, rgba(11, 14, 13, 0.1) 38%, transparent 60%);
      }

      .hero-body {
        position: relative;
        padding: 0 var(--pad) clamp(4rem, 12vh, 9rem);
        max-width: 44rem;
        animation: rise 1.1s cubic-bezier(0.22, 1, 0.36, 1) both;
      }

      @keyframes rise {
        from {
          opacity: 0;
          transform: translateY(1.5rem);
        }
      }

      .tagline {
        font-size: 0.72rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        /* světlejší zlatá — okrová se ztrácela ve světlé části fotky */
        color: #e3bc84;
        margin: 0 0 1.25rem;
        font-weight: 600;
      }

      /* Text v hero leží na fotce, proto mu dáváme vlastní čitelnost
         místo dalšího ztmavování závoje. */
      .hero-body .tagline,
      .hero-body h1,
      .hero-body .lede {
        text-shadow:
          0 1px 2px rgba(8, 11, 10, 0.55),
          0 2px 18px rgba(8, 11, 10, 0.75);
      }

      h1 {
        font-family: var(--display);
        font-weight: 400;
        font-size: clamp(3.5rem, 13vw, 8rem);
        line-height: 0.92;
        letter-spacing: 0.01em;
        margin: 0 0 1.5rem;
      }

      .lede {
        font-size: clamp(1rem, 2.2vw, 1.2rem);
        color: var(--paper-dim);
        max-width: 34rem;
        margin: 0 0 2.5rem;
      }

      .actions {
        display: flex;
        gap: 0.85rem;
        flex-wrap: wrap;
      }

      .btn {
        display: inline-block;
        padding: 0.85rem 1.75rem;
        font-size: 0.82rem;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        text-decoration: none;
        border: 1px solid transparent;
        transition: background 0.3s, color 0.3s, border-color 0.3s;
      }

      .btn.primary {
        background: var(--jade);
        color: var(--ink);
        font-weight: 600;
      }

      .btn.primary:hover {
        background: var(--paper);
      }

      .btn.ghost {
        border-color: rgba(233, 230, 222, 0.35);
        color: var(--paper);
      }

      .btn.ghost:hover {
        border-color: var(--jade);
        color: var(--jade);
      }

      /* odznaky pod tlačítky v hero */
      .badges {
        list-style: none;
        margin: 2rem 0 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
      }

      .badges li {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.78rem;
        letter-spacing: 0.06em;
        color: var(--paper-dim);
        text-shadow: 0 1px 10px rgba(8, 11, 10, 0.8);
      }

      .badges li::before {
        content: '';
        width: 0.4rem;
        height: 0.4rem;
        flex: none;
        transform: rotate(45deg);
        background: var(--jade);
      }

      /* ---------- pásma ---------- */

      .band {
        padding: var(--gap) var(--pad);
        max-width: 82rem;
        margin-inline: auto;
      }

      .eyebrow {
        font-size: 0.7rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--jade);
        margin: 0 0 1rem;
        font-weight: 600;
      }

      h2 {
        font-family: var(--display);
        font-weight: 400;
        font-size: clamp(2rem, 5vw, 3.25rem);
        line-height: 1.1;
        margin: 0 0 1.5rem;
        text-wrap: balance;
      }

      .head {
        max-width: 44rem;
        margin-bottom: clamp(2.5rem, 6vw, 4rem);
      }

      .prose {
        color: var(--paper-dim);
        margin: 0 0 1.15rem;
        max-width: 40rem;
      }

      .prose.wide {
        max-width: 44rem;
      }

      .prose :global(em) {
        color: var(--paper);
        font-style: italic;
      }

      .prose :global(strong) {
        color: var(--paper);
        font-weight: 600;
      }

      .minor {
        font-size: 0.72rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--paper-faint);
        font-weight: 650;
        margin: 2.25rem 0 0.75rem;
      }

      .pull {
        font-family: var(--display);
        font-size: clamp(1.35rem, 2.6vw, 1.8rem);
        line-height: 1.35;
        color: var(--paper);
        margin: 2.25rem 0 0;
        padding-left: 1.5rem;
        border-left: 2px solid var(--jade);
        max-width: 36rem;
      }

      .signature {
        font-family: var(--display);
        font-size: 1.5rem;
        color: var(--paper);
        margin: 2rem 0 0;
      }

      .signature::before {
        content: '';
        display: block;
        width: 2.5rem;
        height: 1px;
        background: var(--amber);
        margin-bottom: 1rem;
      }

      /* dvousloupcové sekce */

      .split {
        display: grid;
        gap: clamp(2.5rem, 6vw, 5rem);
        align-items: center;
      }

      @media (min-width: 900px) {
        .split {
          grid-template-columns: 1fr 1fr;
        }

        .split.reverse .split-text {
          order: 2;
        }
      }

      .split-media {
        margin: 0;
      }

      .split-media img {
        width: 100%;
        aspect-ratio: 4 / 5;
        object-fit: cover;
      }

      .portrait img {
        /* zrcadlení: v profilu se dívá doprava, otočením hledí do textu */
        transform: scaleX(-1);
        filter: grayscale(1) contrast(0.94) brightness(1.06);
      }

      .portrait figcaption {
        margin-top: 0.85rem;
        font-size: 0.72rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--paper-faint);
      }

      @media (min-width: 900px) {
        .split {
          align-items: start;
        }

        .split-media.sticky {
          position: sticky;
          top: 6rem;
        }
      }

      /* symboly */

      .symbols {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 1px;
        background: var(--line);
        border-block: 1px solid var(--line);
      }

      @media (min-width: 640px) {
        .symbols {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (min-width: 1000px) {
        .symbols {
          grid-template-columns: repeat(4, 1fr);
        }
      }

      .symbols li {
        background: var(--ink);
        padding: 2rem 1.5rem;
      }

      .symbols h3 {
        font-family: var(--display);
        font-size: 1.6rem;
        font-weight: 500;
        margin: 0 0 0.15rem;
        color: var(--jade);
      }

      .symbols .sub {
        font-size: 0.68rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--paper-faint);
        margin: 0 0 0.85rem;
      }

      .symbols p {
        margin: 0;
        font-size: 1rem;
        color: var(--paper-dim);
      }

      /* tradice */

      .tradition {
        display: grid;
        gap: clamp(1.75rem, 4vw, 3rem);
      }

      @media (min-width: 860px) {
        .tradition {
          grid-template-columns: repeat(3, 1fr);
        }
      }

      .tradition article {
        border-top: 1px solid var(--amber);
        padding-top: 1.25rem;
      }

      .tradition h3 {
        font-family: var(--display);
        font-size: 1.5rem;
        font-weight: 500;
        margin: 0 0 0.6rem;
      }

      .tradition p {
        margin: 0;
        color: var(--paper-dim);
        font-size: 1rem;
      }

      .tradition :global(em) {
        color: var(--jade);
        font-style: italic;
      }

      /* ---------- galerie ---------- */

      .filters {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-bottom: 2.5rem;
      }

      .chip {
        font-family: inherit;
        font-size: 0.75rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--paper-dim);
        background: none;
        border: 1px solid var(--line);
        padding: 0.5rem 1.1rem;
        cursor: pointer;
        transition: all 0.25s;
      }

      .chip:hover {
        border-color: var(--jade);
        color: var(--jade);
      }

      .chip.on {
        background: var(--jade);
        border-color: var(--jade);
        color: var(--ink);
        font-weight: 600;
      }

      .grid {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: clamp(1.25rem, 3vw, 2.25rem);
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
      }

      .card.hide {
        display: none;
      }

      .shot {
        display: block;
        width: 100%;
        padding: 0;
        border: 0;
        background: var(--surface);
        cursor: zoom-in;
        overflow: hidden;
        aspect-ratio: 1;
      }

      .shot img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.4s;
      }

      .shot:hover img {
        transform: scale(1.05);
        opacity: 0.88;
      }

      .card-body {
        padding-top: 1rem;
      }

      .card h3 {
        font-family: var(--display);
        font-size: 1.35rem;
        font-weight: 500;
        margin: 0 0 0.25rem;
      }

      .meta {
        margin: 0;
        font-size: 0.86rem;
        color: var(--paper-faint);
        letter-spacing: 0.03em;
      }

      .price {
        margin: 0.4rem 0 0;
        font-size: 0.95rem;
        color: var(--jade);
        font-variant-numeric: tabular-nums;
      }

      /* stav dostupnosti — barvou i slovem, ne jen barvou */
      .stav {
        display: inline-block;
        margin: 0.5rem 0 0;
        font-size: 0.7rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        font-weight: 650;
        padding: 0.18rem 0.55rem;
        border: 1px solid currentColor;
        border-radius: 2px;
      }

      .stav.available { color: var(--jade); }
      .stav.reserved { color: var(--amber); }
      .stav.sold { color: var(--paper-faint); }

      .empty {
        color: var(--paper-faint);
      }

      .price-disclaimer {
        margin: 2.5rem 0 0;
        font-size: 0.88rem;
        color: var(--paper-faint);
        max-width: 44rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--line);
      }

      /* ---------- znaky pravosti ---------- */

      .signs {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0;
        counter-reset: s;
      }

      @media (min-width: 800px) {
        .signs {
          grid-template-columns: repeat(2, 1fr);
          column-gap: clamp(2rem, 5vw, 4rem);
        }
      }

      .signs li {
        display: flex;
        gap: 1.25rem;
        padding: 1.5rem 0;
        border-top: 1px solid var(--line);
      }

      .num {
        font-family: var(--display);
        font-size: 1.1rem;
        color: var(--amber);
        flex: none;
        padding-top: 0.2rem;
        font-variant-numeric: tabular-nums;
      }

      .signs h3 {
        font-size: 1.02rem;
        font-weight: 650;
        margin: 0 0 0.35rem;
        letter-spacing: 0.01em;
      }

      .signs p {
        margin: 0;
        font-size: 1rem;
        color: var(--paper-dim);
      }

      .care {
        margin-top: 2.5rem;
        padding: 1.5rem 1.75rem;
        background: var(--surface);
        border-left: 2px solid var(--jade);
        max-width: 44rem;
      }

      .care h3 {
        font-size: 0.72rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--jade);
        margin: 0 0 0.6rem;
        font-weight: 650;
      }

      .care p {
        margin: 0;
        color: var(--paper-dim);
        font-size: 1rem;
      }

      /* ---------- zakázkový formulář ---------- */

      .poptavka {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        max-width: 52rem;
      }

      .row {
        display: grid;
        gap: 1.5rem;
      }

      @media (min-width: 720px) {
        .row {
          grid-template-columns: 1fr 1fr;
        }
      }

      .poptavka label {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      .lbl {
        font-size: 0.78rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--paper-dim);
        font-weight: 600;
      }

      .lbl em {
        font-style: normal;
        text-transform: none;
        letter-spacing: 0.02em;
        color: var(--paper-faint);
        font-weight: 400;
        margin-left: 0.4rem;
      }

      .poptavka input,
      .poptavka select,
      .poptavka textarea {
        font-family: inherit;
        font-size: 1rem;
        color: var(--paper);
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 3px;
        padding: 0.75rem 0.85rem;
        width: 100%;
      }

      .poptavka textarea {
        resize: vertical;
        min-height: 6rem;
      }

      .poptavka :is(input, select, textarea):focus-visible {
        outline: 2px solid var(--jade);
        outline-offset: 1px;
        border-color: var(--jade);
      }

      .poptavka input:user-invalid {
        border-color: var(--amber);
      }

      .send {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1.25rem;
      }

      .poptavka button {
        font-family: inherit;
        cursor: pointer;
        border: 0;
      }

      .form-msg {
        margin: 0;
        font-size: 0.92rem;
        color: var(--paper-dim);
      }

      .form-msg.ok { color: var(--jade); }
      .form-msg.err { color: var(--amber); }

      .gdpr {
        margin: 0;
        font-size: 0.85rem;
        color: var(--paper-faint);
        max-width: 44rem;
      }

      /* ---------- kontakt ---------- */

      .thanks {
        font-family: var(--display);
        font-size: 1.5rem;
        color: var(--paper-dim);
        text-align: center;
        margin: 3rem 0 0;
      }

      .price-note {
        font-family: var(--display);
        font-size: 1.35rem;
        color: var(--amber);
        margin: 1.5rem 0 0;
      }

      .contacts {
        display: grid;
        gap: 1px;
        background: var(--line);
        border: 1px solid var(--line);
      }

      @media (min-width: 780px) {
        .contacts {
          grid-template-columns: repeat(3, 1fr);
        }
      }

      .tile {
        background: var(--ink);
        padding: 2rem 1.75rem;
        text-decoration: none;
        color: var(--paper);
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        transition: background 0.3s;
      }

      .tile:hover {
        background: var(--surface);
      }

      .tile-label {
        font-size: 0.68rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--paper-faint);
      }

      .tile-value {
        font-family: var(--display);
        font-size: 1.4rem;
        color: var(--jade);
        word-break: break-word;
      }

      /* ---------- patička ---------- */

      footer {
        border-top: 1px solid var(--line);
        padding: 2.5rem var(--pad);
        text-align: center;
        color: var(--paper-faint);
        font-size: 0.92rem;
      }

      footer p {
        margin: 0 0 0.35rem;
      }

      .foot-nav {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem 1.5rem;
        margin-bottom: 2rem;
      }

      .foot-nav a {
        color: var(--paper-dim);
        text-decoration: none;
        font-size: 0.88rem;
        letter-spacing: 0.05em;
      }

      .foot-nav a:hover {
        color: var(--jade);
      }

      .place {
        font-size: 0.8rem;
        opacity: 0.75;
      }

      /* ---------- lightbox ---------- */

      .lightbox {
        position: fixed;
        inset: 0;
        z-index: 100;
        background: rgba(6, 8, 7, 0.96);
        display: grid;
        place-items: center;
        padding: clamp(1rem, 5vw, 4rem);
      }

      .lightbox[hidden] {
        display: none;
      }

      .lightbox figure {
        margin: 0;
        max-height: 100%;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        align-items: center;
      }

      .lightbox img {
        max-height: 82vh;
        max-width: 100%;
        object-fit: contain;
      }

      .lightbox figcaption {
        font-family: var(--display);
        font-size: 1.3rem;
        color: var(--paper);
      }

      .lb-close {
        position: absolute;
        top: 1rem;
        right: 1.5rem;
        font-size: 2.5rem;
        line-height: 1;
        background: none;
        border: 0;
        color: var(--paper-dim);
        cursor: pointer;
        padding: 0.5rem;
      }

      .lb-close:hover {
        color: var(--paper);
      }

      :is(a, button):focus-visible {
        outline: 2px solid var(--jade);
        outline-offset: 3px;
      }

      /* plynulé odkrývání sekcí */
      .reveal {
        opacity: 0;
        transform: translateY(1.75rem);
        transition: opacity 0.9s ease, transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .reveal.in {
        opacity: 1;
        transform: none;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        *,
        .reveal {
          animation: none !important;
          transition: none !important;
          opacity: 1 !important;
          transform: none !important;
        }
      }
    </style>

    <script>
      // Odeslání poptávky. Texty a nastavení bereme z atributů formuláře,
      // aby skript zůstal běžným modulem (jinak se nezpracuje TypeScript).
      const form = document.getElementById('commissionForm') as HTMLFormElement | null;

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const msg = document.getElementById('formMsg');
        const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        if (!msg || !btn) return;

        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }

        const cfg = form.dataset;
        const data = new FormData(form);

        if (!cfg.key) {
          // náhradní cesta: otevřeme poštovní program s předvyplněnou zprávou
          const lines: string[] = [];
          for (const [k, v] of data.entries()) {
            if (String(v).trim()) lines.push(`${k}: ${v}`);
          }
          window.location.href =
            `mailto:${cfg.mailto}?subject=${encodeURIComponent(cfg.subject ?? '')}` +
            `&body=${encodeURIComponent(lines.join('\n'))}`;
          return;
        }

        msg.textContent = cfg.sending ?? '';
        msg.className = 'form-msg';
        btn.disabled = true;

        try {
          data.append('access_key', cfg.key);
          data.append('subject', cfg.subject ?? '');
          const res = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            body: data,
          });
          if (!res.ok) throw new Error('bad response');
          form.reset();
          msg.textContent = cfg.ok ?? '';
          msg.className = 'form-msg ok';
        } catch {
          msg.textContent = cfg.err ?? '';
          msg.className = 'form-msg err';
        } finally {
          btn.disabled = false;
          btn.textContent = cfg.submit ?? '';
        }
      });

      // hlavička po odscrollování
      const header = document.getElementById('siteHeader');
      const onScroll = () => header?.classList.toggle('stuck', window.scrollY > 40);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      // odkrývání sekcí při scrollu
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce) {
        const targets = document.querySelectorAll<HTMLElement>('.band');
        targets.forEach((el) => el.classList.add('reveal'));
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -12% 0px' }
        );
        targets.forEach((el) => io.observe(el));
      }

      // filtrování galerie
      const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
      const cards = document.querySelectorAll<HTMLElement>('.card');
      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          const want = chip.dataset.filter;
          chips.forEach((c) => c.classList.toggle('on', c === chip));
          cards.forEach((card) => {
            card.classList.toggle('hide', want !== 'all' && card.dataset.cat !== want);
          });
        });
      });

      // lightbox
      const lb = document.getElementById('lightbox') as HTMLElement | null;
      const lbImg = document.getElementById('lbImg') as HTMLImageElement | null;
      const lbCap = document.getElementById('lbCap');
      const close = () => {
        lb?.setAttribute('hidden', '');
        document.body.style.overflow = '';
      };

      document.querySelectorAll<HTMLButtonElement>('.shot').forEach((shot) => {
        shot.addEventListener('click', () => {
          if (!lb || !lbImg || !lbCap) return;
          const full = shot.dataset.full;
          if (!full) return;
          lbImg.src = full;
          lbImg.alt = shot.dataset.caption ?? '';
          lbCap.textContent = shot.dataset.caption ?? '';
          lb.removeAttribute('hidden');
          document.body.style.overflow = 'hidden';
        });
      });

      document.getElementById('lbClose')?.addEventListener('click', close);
      lb?.addEventListener('click', (e) => {
        if (e.target === lb) close();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') close();
      });
    </script>
  </body>
</html>
